<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <!-- Thanh trên -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#121212"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/btnFlash"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="⚡ Tắt"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnTimer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="⏱ Tắt"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="GPS: đang dò..."
            android:textColor="#FFC400"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="⚙ Dấu"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Khung xem trước -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:scaleType="fitCenter" />

        <vn.nguyenvanhoa.camerastampgps.StampOverlayView
            android:id="@+id/overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/focusRing"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/focus_ring"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/tvCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:shadowColor="#000000"
            android:shadowRadius="12"
            android:textColor="#FFC400"
            android:textSize="120sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Thanh chỉnh độ sáng & zoom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#121212"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvExp"
                android:layout_width="96dp"
                android:layout_height="wrap_content"
                android:text="☀ 0 EV"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/sbExposure"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:progressTint="#FFC400"
                android:thumbTint="#FFC400" />

            <TextView
                android:id="@+id/btnExpReset"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="↺"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvZoom"
                android:layout_width="96dp"
                android:layout_height="wrap_content"
                android:text="🔍 1.0x"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/sbZoom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progressTint="#FFC400"
                android:thumbTint="#FFC400" />

            <TextView
                android:id="@+id/btnZoomReset"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="1x"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Thanh dưới -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:background="#121212">

        <ImageView
            android:id="@+id/thumb"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="28dp"
            android:background="@drawable/thumb_bg"
            android:contentDescription="Ảnh vừa chụp"
            android:padding="2dp"
            android:scaleType="centerCrop" />

        <View
            android:id="@+id/shutter"
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:layout_gravity="center"
            android:background="@drawable/shutter_bg"
            android:contentDescription="Chụp" />

        <TextView
            android:id="@+id/btnSwitch"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="28dp"
            android:gravity="center"
            android:text="⟲"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />
    </FrameLayout>
</LinearLayout>
