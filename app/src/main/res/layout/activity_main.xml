<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <!-- Thanh trên -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#121212"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/btnFlash"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="⚡ Tắt"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="GPS: đang dò..."
            android:textColor="#FFC400"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="⚙ Dấu"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Khung xem trước -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:scaleType="fitCenter" />

        <vn.nguyenvanhoa.camerastampgps.StampOverlayView
            android:id="@+id/overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Thanh dưới -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#121212">

        <ImageView
            android:id="@+id/thumb"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="28dp"
            android:background="@drawable/thumb_bg"
            android:contentDescription="Ảnh vừa chụp"
            android:padding="2dp"
            android:scaleType="centerCrop" />

        <View
            android:id="@+id/shutter"
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:layout_gravity="center"
            android:background="@drawable/shutter_bg"
            android:contentDescription="Chụp" />

        <TextView
            android:id="@+id/btnSwitch"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="28dp"
            android:gravity="center"
            android:text="⟲"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />
    </FrameLayout>
</LinearLayout>
